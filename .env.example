# Copie para .env.local. Este arquivo pertence ao serviço dos bots.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
COLLECTION_INTERVAL_SECONDS=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=false

# Opcional: habilite somente depois de conferir o destino.
DELIVERY_ENABLED=false
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEWS_ALERT_CATEGORIES=Regulação,Segurança,Institucional
FUNDING_EXTREME_PERCENT=0.1

# Resumo diário por módulo do curso. -1 desativa; 11 = 08h em São Paulo (UTC-3).
# Se o serviço estava desligado na hora, o resumo sai no primeiro ciclo depois dela, no mesmo dia (UTC).
DAILY_BRIEF_UTC_HOUR=11
DIGEST_ITEMS=10

# Alerta imediato: tema em NEWS_ALERT_CATEGORIES OU importância >= este valor (-1 desativa o limite).
# Categorias: Regulação, Segurança, Institucional, Macroeconomia, Memecoins, Futuros, Tecnologia, Mercado.
ALERT_MIN_IMPORTANCE=7

# Opcional: IA para importância, contexto e tradução PT-BR de manchetes EN/ES, somente no serviço. API paga.
# Sem chave/habilitação, o radar usa regras explicáveis e não faz chamadas de IA.
NEWS_AI_ENABLED=false
OPENAI_API_KEY=
NEWS_AI_MODEL=gpt-5-mini
NEWS_AI_INTERVAL_SECONDS=300
NEWS_AI_BATCH_SIZE=10
NEWS_AI_MAX_BATCHES_PER_DAY=48
